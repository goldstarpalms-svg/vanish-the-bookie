# Default preview is entirely synthetic. No API key is needed.
DATA_MODE=demo
PORT=3000

# Optional official WhatsApp invite. Use your public group/channel link,
# not a personal phone number unless you intend to publish it.
WHATSAPP_URL=

# LIVE DATA — never place credentials in browser code or commit .env.
# The optional live adapter derives market-implied estimates from odds.
# It is not an independently trained model or evidence of a betting edge.
# Set DATA_MODE=live only after checking your provider plan and display rights.
ODDS_API_KEY=
LIVE_SPORT_KEYS=soccer_epl,basketball_nba
ODDS_REGIONS=uk
LIVE_REFRESH_MINUTES=60
# Tennis uses tournament-specific sport keys. Choose an active key from
# the provider's sports endpoint; do not assume a year-round tennis key.
